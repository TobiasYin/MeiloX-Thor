{
  "schemaVersion": "1.0.0",
  "defaultTheme": "ceramic",
  "defaultAppearance": "system",
  "scope": "Design prototype; independent from device geometry and playback state",
  "foundation": {
    "fontFamily": "Inter, 'Noto Sans SC', 'PingFang SC', system-ui, sans-serif",
    "spacing": [4, 8, 12, 16, 20, 24, 32, 48],
    "minimumTouchTarget": 48,
    "typography": {
      "display": {"size": 38, "weight": 500},
      "pageTitle": {"size": 20, "weight": 500},
      "playerTitle": {"size": 24, "weight": 500},
      "body": {"size": 16, "weight": 500},
      "secondary": {"size": 12, "weight": 400},
      "control": {"size": 14, "weight": 400},
      "caption": {"size": 11, "weight": 400},
      "lyricCurrent": {"size": 28, "weight": 500},
      "lyricAdjacent": {"size": 19, "weight": 400},
      "lyricTranslation": {"size": 14, "weight": 400}
    },
    "lyricLayout": {
      "rowGap": 16, "rowVerticalInset": 8, "auxiliaryTopGap": 8, "auxiliaryGap": 6, "lineHeightEm": 1.5
    },
    "motion": {
      "pressMs": 120, "surfaceMs": 180, "caseMs": 320, "menuEnterMs": 170,
      "blow": {
        "axis": "positive-y",
        "maximumDegreesPerSecond": 600,
        "strengthExponent": 1.45,
        "inputAttackMs": 80,
        "inputReleaseMs": 180,
        "accelerationMs": 200,
        "decelerationMs": 420,
        "demoPulseMs": 1200,
        "restDegrees": -16,
        "settleOmega": 8,
        "settleDamping": 16,
        "momentumProjectionMs": 180,
        "dragDegreesPerWidth": 360,
        "dragMaximumSpeed": 900
      }
    },
    "state": {"disabledOpacity": 0.45, "selectionStroke": 1.5},
    "componentMaterials": {
      "MusicRow": "flat; selected surface when selected",
      "CompactHeader": "panel",
      "NavRail": "panel",
      "NowPlayingBar": "panel",
      "PlayerDeck": "inset",
      "ActionButton": "raised",
      "PrimaryActionButton": "enamel",
      "ProgressTrack": "inset",
      "Overlay": "opaque elevated panel",
      "ContextMenu": "anchored opaque elevated panel; semantic liked/collected/focus states",
      "PlaylistSubmenu": "same-anchor opaque elevated panel; select one target and commit",
      "Feedback": "surface with optional undo action"
    }
  },
